<?xml version="1.0" encoding="utf-8"?>
<!--
    The app icon's picture: a barbell with an arrow pointing up above it ("lift a
    little more"). It is plain white, so the same drawing also serves as the
    single-colour themed icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Drawn to the edge of the middle 66 x 66 of the canvas (the part every launcher
        shape shows), then shrunk a little so it has room to breathe.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.88"
        android:scaleY="0.88">
        <!-- the bar -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M25.5,57h57a2.5,2.5 0,0 1,0 5h-57a2.5,2.5 0,0 1,0 -5z" />
        <!-- outer plates -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M28.5,48.5h1a2.5,2.5 0,0 1,2.5 2.5v17a2.5,2.5 0,0 1,-2.5 2.5h-1a2.5,2.5 0,0 1,-2.5 -2.5v-17a2.5,2.5 0,0 1,2.5 -2.5z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M78.5,48.5h1a2.5,2.5 0,0 1,2.5 2.5v17a2.5,2.5 0,0 1,-2.5 2.5h-1a2.5,2.5 0,0 1,-2.5 -2.5v-17a2.5,2.5 0,0 1,2.5 -2.5z" />
        <!-- inner plates -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M36.5,41.5h1.5a3,3 0,0 1,3 3v30a3,3 0,0 1,-3 3h-1.5a3,3 0,0 1,-3 -3v-30a3,3 0,0 1,3 -3z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M70,41.5h1.5a3,3 0,0 1,3 3v30a3,3 0,0 1,-3 3h-1.5a3,3 0,0 1,-3 -3v-30a3,3 0,0 1,3 -3z" />
        <!-- the arrow -->
        <path
            android:pathData="M54,50L54,33M46.5,40L54,32.5L61.5,40"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="4" />
    </group>
</vector>
