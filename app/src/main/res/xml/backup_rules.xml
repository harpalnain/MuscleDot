<?xml version="1.0" encoding="utf-8"?>
<!--
   Overload keeps everything on the phone. Nothing is backed up by Android;
   the only way data leaves the phone is the backup file the user exports.
   (Used on Android 11 and lower; newer versions read data_extraction_rules.xml.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
